<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="home-container" style="flex-grow: 1; justify-content: center; align-items: center; align-self: center; align-content: center; width: 549px;">
        <ui:Label text="AR Experience" name="title-lable" style="color: rgb(253, 245, 230);"/>
        <ui:Button text="Scan Now" name="start-button" style="align-self: center; justify-content: space-around; align-items: center; align-content: center; -unity-text-align: middle-center; white-space: normal; text-overflow: clip;"/>
        <ui:Label text="Label" name="status-label" style="color: rgb(253, 245, 230);"/>
    </ui:VisualElement>
</ui:UXML>
